#!/bin/bash
# Serial warm runner. Initialized inputs must already be prepared and frozen.
set -e
cd "$(dirname "$0")"
if ! command -v foamRun >/dev/null 2>&1; then
    source /opt/openfoam14/etc/bashrc
fi
set -u -o pipefail
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
if [ "$(id -u)" = 0 ]; then
    echo "Launch the serial warm case as the non-root openfoam account." >&2
    exit 2
fi
if [ -e log.foamRun ] || [ -e .warm-solver-started ] || compgen -G 'processor*' >/dev/null; then
    echo "Refusing to overwrite a previously started/decomposed case." >&2
    exit 2
fi
python3 ./prepare_mapped.py --case . --verify-only
initialization_hash=$(sha256sum initialization.json)
test "$(foamDictionary system/controlDict -entry startFrom -value)" = startTime
test "$(foamDictionary system/controlDict -entry startTime -value)" = 0.6
test "$(foamDictionary system/controlDict -entry stopAt -value)" = endTime
test "$(foamDictionary system/decomposeParDict -entry numberOfSubdomains -value)" = 1
test ! -e 0.6/phi
date -u +%FT%TZ > .warm-solver-started
foamRun > log.foamRun 2>&1
grep -q '^End[[:space:]]*$' log.foamRun
if grep -q 'FOAM FATAL\|MPI_ABORT' log.foamRun; then
    echo "Solver reported a fatal error." >&2
    exit 3
fi
test "$(sha256sum initialization.json)" = "$initialization_hash"
python3 ./prepare_mapped.py --case . --verify-only
