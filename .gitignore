# Exact large dependencies live in the separately delivered, SHA-pinned archive.
# These rules do not remove files already tracked or rewrite earlier commits.
/cases/*/0.[0-9]*/
/cases/*/[1-9]*/
/study/gpu_feasibility/c29_managed_strict/base/saved_fields/
/study/gpu_feasibility/c29_managed_strict/base/shared_initial/phi
*.zip
*.tar.gz
*.tgz
*.tar.xz
*.7z
*.zst

# Generated cases, meshes, decompositions and caches; retain initial 0/ inputs.
/fresh_cases/
/fresh_pilots/
/fresh_pilots_preparation.json
/fresh_numerical_configurations.json
/.external-inputs-*/
/new_results/
/cases/*/constant/polyMesh/
/cases/*/processor[0-9]*/
/cases/*/postProcessing/
**/dynamicCode/
**/lnInclude/
**/Make/linux*/
**/__pycache__/
.venv/
.pytest_cache/
*.py[cod]
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.exe

# Transient control files; curated actual run/failure/build logs stay tracked.
*.tmp
*.updated
*.lock
*.pid
.codex-study-export.json
.env
.env.*

# Raw profiling outputs/SDK payloads are outside the source projection.
*.nsys-rep
*.qdrep
*.qdstrm
*.ncu-rep
*.sqlite
*.sqlite3
*.db
