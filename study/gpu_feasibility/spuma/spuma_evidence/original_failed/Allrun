set -o pipefail
cd -- "$(dirname -- "$0")" || exit
test ! -e .spuma-smoke-started || exit 73
. /opt/openfoam-workspace/gpu-feasibility/spuma/env.sh || exit
test "$WM_PROJECT_DIR" = /opt/openfoam-workspace/gpu-feasibility/spuma/source || exit
test "$have_cuda" = true || exit
test "$have_umpire" = false || exit
set -e
touch .spuma-smoke-started
/usr/bin/python3 record_runtime_artifacts.py start
/usr/bin/nice -n 15 /opt/openfoam-workspace/gpu-feasibility/spuma/source/platforms/linuxARM64NvidiaDPInt32Opt/bin/blockMesh -pool fixedSizeMemoryPool -poolSize 1 > log.blockMesh 2>&1
