include $(GENERAL_RULES)/Nvidia/c++

c++ARCH    :=
c++DEVICE  := -stdpar=gpu -gpu=cc121,mem:managed -DFOAM_OFFLOAD
c++WARN    += --diag_suppress=3293

ifneq (,$(strip $(WM_COMPILE_OPTION)))
    sinclude $(DEFAULT_RULES)/c++$(WM_COMPILE_OPTION)
endif

c++FLAGS    = \
    $(c++ARCH) $(c++DEVICE) $(GFLAGS) \
    $(c++WARN) $(c++OPT) $(c++DBUG) $(ptFLAGS) \
    $(FOAM_EXTRA_CXXFLAGS) $(LIB_HEADER_DIRS) -fPIC

Ctoo        = $(WM_SCHEDULER) $(CC) $(c++FLAGS) -c $< -o $@
cctoo       = $(Ctoo)
cpptoo      = $(Ctoo)
cxxtoo      = $(Ctoo)

include $(GENERAL_RULES)/Nvidia/link-c++

