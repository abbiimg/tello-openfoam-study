FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       startTime;

startTime       0.6;

stopAt          endTime;

endTime         0.60085;

deltaT          0.0001;

writeControl    adjustableRunTime;

writeInterval   0.01;

writeFormat     ascii;

writePrecision  9;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.9;

maxDeltaT       0.0008;

functions
{
    pilotFields
    {
        type            writeObjects;
        libs            ( "libutilityFunctionObjects.so" );
        objects         ( U p phi );
        writeOption     anyWrite;
        writeControl    timeStep;
        writeInterval   5;
    }
}

libs            ( "/opt/openfoam-workspace/gpu-feasibility/amgx-cuda/install/lib/libAmgXPressure.so" );


