FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          AmgXPressure;
        tolerance       1e-07;
        relTol          0.05;
        maxIter         1000;
        minIter         0;
    }
    pFinal
    {
        solver          AmgXPressure;
        tolerance       1e-07;
        relTol          0;
        maxIter         1000;
        minIter         0;
    }
    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-07;
        relTol          0.05;
    }
    UFinal
    {
        $U              ;
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors 1;
    nCorrectors     2;
    nNonOrthogonalCorrectors 0;
}


