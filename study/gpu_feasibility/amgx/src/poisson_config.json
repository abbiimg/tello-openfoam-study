{
  "config_version": 2,
  "solver": {
    "solver": "PCG",
    "max_iters": 300,
    "tolerance": 1e-10,
    "norm": "L2",
    "convergence": "RELATIVE_INI_CORE",
    "monitor_residual": 1,
    "store_res_history": 1,
    "print_solve_stats": 1,
    "preconditioner": {
      "solver": "AMG",
      "algorithm": "AGGREGATION",
      "selector": "SIZE_2",
      "cycle": "V",
      "presweeps": 1,
      "postsweeps": 1,
      "max_iters": 1,
      "max_levels": 100,
      "coarse_solver": "DENSE_LU_SOLVER",
      "smoother": { "solver": "BLOCK_JACOBI" }
    }
  }
}
