#!/bin/bash
# Warm-start, two-rank runner. Launch once as the non-root openfoam account.
# For a generated case lacking initialization.json, pass the same-geometry
# completed source case as the sole argument. Preparation never runs a solver.
set -e
cd "$(dirname "$0")"
if ! command -v foamRun >/dev/null 2>&1; then
    source /opt/openfoam14/etc/bashrc
fi
set -u -o pipefail
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
if [ "$(id -u)" = 0 ]; then
    echo "Launch the warm solver as the non-root openfoam account." >&2
    exit 2
fi
if [ -e log.foamRun ] || [ -e .warm-solver-started ] || compgen -G 'processor*' >/dev/null; then
    echo "Refusing to overwrite a previously started/decomposed case." >&2
    exit 2
fi
if [ -f initialization.json ]; then
    python3 ./prepare_mapped.py --case . --verify-only
else
    test "$#" = 1 || { echo "Provide the completed same-geometry source case." >&2; exit 2; }
    python3 ./prepare_mapped.py --case . --source "$1" --skip-runner-install
fi
test "$(foamDictionary system/controlDict -entry startFrom -value)" = startTime
test "$(foamDictionary system/controlDict -entry startTime -value)" = 0.6
test "$(foamDictionary system/controlDict -entry stopAt -value)" = endTime
test "$(foamDictionary system/decomposeParDict -entry numberOfSubdomains -value)" = 2
test ! -e 0.6/phi

# Preserve the mapped initial fields: decompose exactly 0.6; never reconstruct it.
decomposePar -time 0.6 > log.decomposePar 2>&1
for rank in 0 1; do
    cp constant/rotorParameters "processor${rank}/constant/rotorParameters"
    cmp constant/rotorParameters "processor${rank}/constant/rotorParameters"
done
date -u +%FT%TZ > .warm-solver-started
mpirun --bind-to none -np 2 foamRun -parallel > log.foamRun 2>&1
grep -q '^End[[:space:]]*$' log.foamRun
if grep -q 'FOAM FATAL' log.foamRun; then
    echo "Solver reported a fatal error." >&2
    exit 3
fi
reconstructPar -time '0.60000001:' > log.reconstructPar 2>&1
python3 ./prepare_mapped.py --case . --verify-only
